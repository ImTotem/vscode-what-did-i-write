{
  "name": "what-did-i-write",
  "type": "commonjs",
  "publisher": "local-only",
  "displayName": "%extension.displayName%",
  "version": "0.1.0",
  "description": "%extension.description%",
  "license": "UNLICENSED",
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "history",
    "blame",
    "local-only"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "myCode.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "myCode.showOutput",
        "title": "%command.showOutput%",
        "icon": "$(output)"
      },
      {
        "command": "myCode.retryIdentity",
        "title": "%command.retryIdentity%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "myCode.openFile",
        "title": "%command.openFile%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "myCode.focusFileHistory",
        "title": "%command.focusFileHistory%",
        "icon": "$(history)"
      },
      {
        "command": "myCode.focusLineHistory",
        "title": "%command.focusLineHistory%",
        "icon": "$(list-tree)"
      },
      {
        "command": "myCode.showFileHistory",
        "title": "%command.showFileHistory%",
        "icon": "$(history)"
      },
      {
        "command": "myCode.showLineHistory",
        "title": "%command.showLineHistory%",
        "icon": "$(list-tree)"
      },
      {
        "command": "myCode.toggleLineBackground",
        "title": "%command.toggleLineBackground%",
        "icon": "$(color-mode)"
      },
      {
        "command": "myCode.expandAll",
        "title": "%command.expandAll%",
        "icon": "$(expand-all)"
      },
      {
        "command": "myCode.collapseAll",
        "title": "%command.collapseAll%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "myCode.hideDecorations",
        "title": "%command.hideDecorations%",
        "icon": "$(eye-closed)",
        "enablement": "myCode.visualsEnabled"
      },
      {
        "command": "myCode.showDecorations",
        "title": "%command.showDecorations%",
        "icon": "$(eye)",
        "enablement": "!myCode.visualsEnabled"
      },
      {
        "command": "myCode.openToSide",
        "title": "%command.openToSide%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "myCode.revealInExplorer",
        "title": "%command.revealInExplorer%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "myCode.revealInOs",
        "title": "%command.revealInOs%",
        "icon": "$(folder-library)"
      },
      {
        "command": "myCode.copyPath",
        "title": "%command.copyPath%",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.copyRelativePath",
        "title": "%command.copyRelativePath%",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.copyHistoricalPath",
        "title": "%command.copyHistoricalPath%",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.copyHistoricalRelativePath",
        "title": "%command.copyHistoricalRelativePath%",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.cut",
        "title": "%command.cut%",
        "icon": "$(cut)"
      },
      {
        "command": "myCode.copy",
        "title": "%command.copy%",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.paste",
        "title": "%command.paste%",
        "icon": "$(clippy)"
      },
      {
        "command": "myCode.newFile",
        "title": "%command.newFile%",
        "icon": "$(new-file)"
      },
      {
        "command": "myCode.newFolder",
        "title": "%command.newFolder%",
        "icon": "$(new-folder)"
      },
      {
        "command": "myCode.rename",
        "title": "%command.rename%",
        "icon": "$(edit)"
      },
      {
        "command": "myCode.delete",
        "title": "%command.delete%",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "myCode.editor.lineBackground": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.lineBackground.description%"
        },
        "myCode.visuals.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.visuals.description%"
        }
      }
    },
    "colors": [
      {
        "id": "myCode.editor.committedLineBackground",
        "description": "%color.committedLineBackground.description%",
        "defaults": {
          "dark": "#2EA0431A",
          "light": "#1A7F371A",
          "highContrast": "#2EA04333",
          "highContrastLight": "#1A7F3733"
        }
      },
      {
        "id": "myCode.editor.workingLineBackground",
        "description": "%color.workingLineBackground.description%",
        "defaults": {
          "dark": "#D299221A",
          "light": "#9A67001A",
          "highContrast": "#D2992233",
          "highContrastLight": "#9A670033"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myCode",
          "title": "%viewContainer.myCode.title%",
          "icon": "media/my-code.svg"
        }
      ]
    },
    "views": {
      "myCode": [
        {
          "id": "myCode.explorer",
          "name": "%view.myChanges.name%"
        },
        {
          "id": "myCode.pastActivity",
          "name": "%view.pastActivity.name%",
          "visibility": "collapsed"
        },
        {
          "id": "myCode.history",
          "name": "%view.fileHistory.name%",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "myCode.explorer",
        "contents": "%viewWelcome.myChanges.contents%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "myCode.refresh",
          "when": "view == myCode.explorer",
          "group": "navigation@1"
        },
        {
          "command": "myCode.expandAll",
          "when": "view == myCode.explorer && !myCode.treeAllExpanded",
          "group": "navigation@2"
        },
        {
          "command": "myCode.collapseAll",
          "when": "view == myCode.explorer && myCode.treeAllExpanded",
          "group": "navigation@2"
        },
        {
          "command": "myCode.hideDecorations",
          "when": "view == myCode.explorer && myCode.visualsEnabled",
          "group": "navigation@3"
        },
        {
          "command": "myCode.showDecorations",
          "when": "view == myCode.explorer && !myCode.visualsEnabled",
          "group": "navigation@3"
        }
      ],
      "view/item": [
        {
          "command": "myCode.openFile",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.openToSide",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.showFileHistory",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.revealInExplorer",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.revealInOs",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.copyPath",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.copyRelativePath",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.cut",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.copy",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.paste",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.rename",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.delete",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.revealInExplorer",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.revealInOs",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.copyPath",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.copyRelativePath",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.newFile",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.newFolder",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.cut",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.copy",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.paste",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.rename",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.delete",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.revealInExplorer",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.revealInOs",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.copyPath",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.copyRelativePath",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.newFile",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.newFolder",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.cut",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.copy",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.paste",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.showFileHistory",
          "when": "view == myCode.pastActivity && viewItem == myCode.pastFile"
        },
        {
          "command": "myCode.copyHistoricalPath",
          "when": "view == myCode.pastActivity && viewItem == myCode.pastFile"
        },
        {
          "command": "myCode.copyHistoricalRelativePath",
          "when": "view == myCode.pastActivity && viewItem == myCode.pastFile"
        }
      ],
      "editor/title": [
        {
          "command": "myCode.toggleLineBackground",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:extension-host": "node test/extensionHost/runSmoke.cjs",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "l10n": "./l10n"
}
