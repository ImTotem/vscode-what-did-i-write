{
  "name": "what-did-i-write",
  "type": "commonjs",
  "publisher": "local-only",
  "displayName": "What Did I Write?",
  "version": "0.1.0",
  "description": "Find the files, lines, and commits you authored.",
  "license": "UNLICENSED",
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "history",
    "blame",
    "local-only"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "myCode.refresh",
        "title": "What Did I Write?: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "myCode.showOutput",
        "title": "What Did I Write?: Show Output",
        "icon": "$(output)"
      },
      {
        "command": "myCode.retryIdentity",
        "title": "What Did I Write?: Retry",
        "icon": "$(debug-restart)"
      },
      {
        "command": "myCode.openFile",
        "title": "What Did I Write?: Open",
        "icon": "$(go-to-file)"
      },
      {
        "command": "myCode.focusFileHistory",
        "title": "What Did I Write?: Focus File History",
        "icon": "$(history)"
      },
      {
        "command": "myCode.focusLineHistory",
        "title": "What Did I Write?: Focus Line History",
        "icon": "$(list-tree)"
      },
      {
        "command": "myCode.showFileHistory",
        "title": "What Did I Write?: Show File History",
        "icon": "$(history)"
      },
      {
        "command": "myCode.showLineHistory",
        "title": "What Did I Write?: Show Line History",
        "icon": "$(list-tree)"
      },
      {
        "command": "myCode.toggleLineBackground",
        "title": "What Did I Write?: Toggle Line Background",
        "icon": "$(color-mode)"
      },
      {
        "command": "myCode.expandAll",
        "title": "What Did I Write?: Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "myCode.collapseAll",
        "title": "What Did I Write?: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "myCode.hideDecorations",
        "title": "What Did I Write?: Hide My Code Decorations",
        "icon": "$(eye-closed)",
        "enablement": "myCode.visualsEnabled"
      },
      {
        "command": "myCode.showDecorations",
        "title": "What Did I Write?: Show My Code Decorations",
        "icon": "$(eye)",
        "enablement": "!myCode.visualsEnabled"
      },
      {
        "command": "myCode.openToSide",
        "title": "What Did I Write?: Open to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "myCode.revealInExplorer",
        "title": "What Did I Write?: Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "myCode.revealInOs",
        "title": "What Did I Write?: Reveal in File Manager",
        "icon": "$(folder-library)"
      },
      {
        "command": "myCode.copyPath",
        "title": "What Did I Write?: Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.copyRelativePath",
        "title": "What Did I Write?: Copy Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.copyHistoricalPath",
        "title": "What Did I Write?: Copy Historical Path",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.copyHistoricalRelativePath",
        "title": "What Did I Write?: Copy Historical Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.cut",
        "title": "What Did I Write?: Cut",
        "icon": "$(cut)"
      },
      {
        "command": "myCode.copy",
        "title": "What Did I Write?: Copy",
        "icon": "$(copy)"
      },
      {
        "command": "myCode.paste",
        "title": "What Did I Write?: Paste",
        "icon": "$(clippy)"
      },
      {
        "command": "myCode.newFile",
        "title": "What Did I Write?: New File",
        "icon": "$(new-file)"
      },
      {
        "command": "myCode.newFolder",
        "title": "What Did I Write?: New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "myCode.rename",
        "title": "What Did I Write?: Rename",
        "icon": "$(edit)"
      },
      {
        "command": "myCode.delete",
        "title": "What Did I Write?: Delete",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "What Did I Write?",
      "properties": {
        "myCode.editor.lineBackground": {
          "type": "boolean",
          "default": false,
          "description": "Highlight your owned lines with a subtle background color."
        },
        "myCode.visuals.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show What Did I Write? ownership colors and markers in Explorer and the editor."
        }
      }
    },
    "colors": [
      {
        "id": "myCode.editor.committedLineBackground",
        "description": "Subtle background for committed code owned by you.",
        "defaults": {
          "dark": "#2EA0431A",
          "light": "#1A7F371A",
          "highContrast": "#2EA04333",
          "highContrastLight": "#1A7F3733"
        }
      },
      {
        "id": "myCode.editor.workingLineBackground",
        "description": "Subtle background for uncommitted code owned by you.",
        "defaults": {
          "dark": "#D299221A",
          "light": "#9A67001A",
          "highContrast": "#D2992233",
          "highContrastLight": "#9A670033"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myCode",
          "title": "MY CODE",
          "icon": "media/my-code.svg"
        }
      ]
    },
    "views": {
      "myCode": [
        {
          "id": "myCode.explorer",
          "name": "MY CHANGES"
        },
        {
          "id": "myCode.pastActivity",
          "name": "PAST ACTIVITY",
          "visibility": "collapsed"
        },
        {
          "id": "myCode.history",
          "name": "FILE HISTORY",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "myCode.explorer",
        "contents": "Your changed files appear here.\n[Refresh What Did I Write?](command:myCode.refresh)\nOpen a changed file and hover one of your marked lines to see file and line history."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "myCode.refresh",
          "when": "view == myCode.explorer",
          "group": "navigation@1"
        },
        {
          "command": "myCode.expandAll",
          "when": "view == myCode.explorer && !myCode.treeAllExpanded",
          "group": "navigation@2"
        },
        {
          "command": "myCode.collapseAll",
          "when": "view == myCode.explorer && myCode.treeAllExpanded",
          "group": "navigation@2"
        },
        {
          "command": "myCode.hideDecorations",
          "when": "view == myCode.explorer && myCode.visualsEnabled",
          "group": "navigation@3"
        },
        {
          "command": "myCode.showDecorations",
          "when": "view == myCode.explorer && !myCode.visualsEnabled",
          "group": "navigation@3"
        }
      ],
      "view/item": [
        {
          "command": "myCode.openFile",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.openToSide",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.showFileHistory",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.revealInExplorer",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.revealInOs",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.copyPath",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.copyRelativePath",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.cut",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.copy",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.paste",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.rename",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.delete",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.revealInExplorer",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.revealInOs",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.copyPath",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.copyRelativePath",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.newFile",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.newFolder",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.cut",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.copy",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.paste",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.rename",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.delete",
          "when": "view == myCode.explorer && viewItem == myCode.folder"
        },
        {
          "command": "myCode.revealInExplorer",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.revealInOs",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.copyPath",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.copyRelativePath",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.newFile",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.newFolder",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.cut",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.copy",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.paste",
          "when": "view == myCode.explorer && viewItem == myCode.repository"
        },
        {
          "command": "myCode.showFileHistory",
          "when": "view == myCode.pastActivity && viewItem == myCode.pastFile"
        },
        {
          "command": "myCode.copyHistoricalPath",
          "when": "view == myCode.pastActivity && viewItem == myCode.pastFile"
        },
        {
          "command": "myCode.copyHistoricalRelativePath",
          "when": "view == myCode.pastActivity && viewItem == myCode.pastFile"
        }
      ],
      "editor/title": [
        {
          "command": "myCode.toggleLineBackground",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:extension-host": "node test/extensionHost/runSmoke.cjs",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
