{
  "name": "my-code",
  "type": "commonjs",
  "displayName": "My Code",
  "version": "0.1.0",
  "description": "Show code owned by the current Git user.",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "myCode.refresh",
        "title": "My Code: Refresh"
      },
      {
        "command": "myCode.showOutput",
        "title": "My Code: Show Output"
      },
      {
        "command": "myCode.retryIdentity",
        "title": "My Code: Retry"
      },
      {
        "command": "myCode.openFile",
        "title": "My Code: Open File"
      },
      {
        "command": "myCode.showFileHistory",
        "title": "My Code: Show File History"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "myCode.explorer",
          "name": "MY CODE"
        }
      ]
    },
    "menus": {
      "view/item": [
        {
          "command": "myCode.showFileHistory",
          "when": "view == myCode.explorer && viewItem == myCode.file"
        },
        {
          "command": "myCode.showFileHistory",
          "when": "view == myCode.explorer && viewItem == myCode.pastFile"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
